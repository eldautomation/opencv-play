[metadata]
name = autocollimator
version = 0.1.0
description = Autocollimator utilities: target finding, sensor IO, and test report generation.
long_description = file: README.md
long_description_content_type = text/markdown

[options]
package_dir =
    = src
packages = find:
python_requires = >=3.10
install_requires =
    numpy>=1.24
    opencv-python>=4.8
    PyYAML>=6.0
    reportlab>=4.0

[options.packages.find]
where = src

[options.extras_require]
dev =
    pytest>=8.0
    pytest-cov>=5.0
    mypy>=1.8
    ruff>=0.4
